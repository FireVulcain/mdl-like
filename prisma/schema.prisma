generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  media         UserMedia[]
  activityLogs  ActivityLog[]
  podiums       ProfilePodium[]
  preferences   UserPreferences?
  recFeedback   RecommendationFeedback[]
  radarExclusions ActorRadarExclusion[]
  radarPins     ActorRadarPin[]
  lastSeenSync  DateTime?
}

// Actors the user manually added to the "From Actors You Watch" radar —
// always scanned, regardless of computed affinity.
model ActorRadarPin {
  id           String   @id @default(cuid())
  userId       String
  personSlug   String // bare kuryana person slug
  name         String
  profileImage String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, personSlug])
  @@index([userId])
}

// Actors the user has removed from the "From Actors You Watch" radar.
// Kept as rows (not a Json blob) so they can be listed and restored.
model ActorRadarExclusion {
  id           String   @id @default(cuid())
  userId       String
  personSlug   String // bare kuryana person slug, e.g. "22074-go-yoon-jung"
  name         String
  profileImage String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, personSlug])
  @@index([userId])
}

// "Not interested" dismissals from the recommendation dialog. Keyed by show+season
// (not UserMedia id) so the signal survives watchlist row deletion/re-creation.
model RecommendationFeedback {
  id         String   @id @default(cuid())
  userId     String
  externalId String
  season     Int      @default(1)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId, season])
  @@index([userId])
}

model UserPreferences {
  userId                     String  @id
  calendarAsianOnly          Boolean @default(false)
  calendarIncludePlanToWatch Boolean @default(true)
  // MDL tags excluded from the home top lists: [{ id, name }].
  // null = app defaults, [] = user explicitly cleared all exclusions.
  homeExcludedTags           Json?
  // Also apply homeExcludedTags as default filters on the /dramas browse page
  applyExcludedTagsToBrowse  Boolean @default(false)
  // Watchlist view defaults (URL params still win for a session)
  watchlistThumbnailStyle    String  @default("poster") // "poster" | "backdrop"
  watchlistDefaultSort       String  @default("default")
  // Ordered home sections: [{ id, enabled }]. null = default layout.
  homeSections               Json?
  // Initial status in the "add to watchlist" dialog
  defaultAddStatus           String  @default("Watching")
  // "english" | "native" — applied where a native title is known (home universes, media pages)
  titleLanguage              String  @default("english")
  // Hide episode names/synopsis beyond current progress (episode guide, calendar, countdown)
  hideSpoilers               Boolean @default(false)
  // Public profile /u/<id>: reachable at all, and which blocks visitors see
  publicProfileEnabled       Boolean @default(true)
  publicShowScores           Boolean @default(true)
  publicShowPodium           Boolean @default(true)
  publicShowActivity         Boolean @default(true)
  // In-app banner after a background sync
  showSyncNotification       Boolean @default(true)
  // Chords that open the command palette, e.g. ["ctrl+k"]. null = app defaults.
  commandPaletteShortcuts    Json?
  // Personal MyDramaList profile. Empty/null hides the MDL link in the header.
  mdlProfileUrl              String?
  // /dramas browse layout: "grid" posters or "list" MDL-style rows.
  // A ?view= param still wins for the session.
  dramasView                 String  @default("grid")
  // "dark" | "light". next-themes keeps owning the switch and the pre-paint
  // class; this is the copy that makes the choice follow the account to a
  // browser whose localStorage has never seen this site.
  theme                      String  @default("dark")
  user                       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserMedia {
  id            String    @id @default(cuid())
  userId        String
  externalId    String
  source        String
  mediaType     String
  status        String
  progress      Int
  totalEp       Int?
  score         Float?
  title         String?
  poster        String?
  year          Int?
  originCountry String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  notes         String?
  season        Int       @default(1)
  tmdbRating    Float?
  genres        String?
  backdrop      String?
  mdlRating     Float?
  airingStatus  String?
  lastWatchedAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfilePodium {
  id         String  @id @default(cuid())
  userId     String
  category   String // "general" | "kdrama" | "cdrama"
  rank       Int // 1, 2, 3
  externalId String
  source     String
  mediaType  String
  title      String
  poster     String?
  year       Int?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, rank])
  @@index([userId, category])
}

model SyncLog {
  id       String   @id @default("daily-sync")
  lastSync DateTime @default(now())
  results  Json?
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  userMediaId String?
  externalId  String
  source      String
  mediaType   String
  title       String
  poster      String?
  action      String
  payload     Json?
  createdAt   DateTime @default(now())
  isBackfill  Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userMediaId])
}

model CachedMdlData {
  id             String   @id @default(cuid())
  tmdbExternalId String   @unique
  mdlSlug        String
  mdlDisabled    Boolean  @default(false)
  mdlRating      Float?
  mdlRanking     Int?
  mdlPopularity  Int?
  mdlWatchers    Int?
  tags           Json?
  genres         Json?
  castJson       Json?
  directors      Json?
  screenwriters  Json?
  // MDL's own broadcast range for THIS entry, e.g. "Aug 7, 2026 - Sep 19, 2026".
  // MDL files each season as its own entry, so it is the only per-season
  // source we have: TMDB's first/last_air_date are show-level.
  aired          String?
  synopsis       String?
  // Last light refresh of the volatile numbers (rating, rank, watchers).
  // Deliberately separate from cachedAt: bumping that one would keep pushing
  // the 7-day cast/synopsis cycle out of reach on pages viewed often.
  liveRefreshedAt DateTime?
  cachedAt       DateTime @default(now())
}

// One day's reading of the numbers that move on an MDL entry.
//
// MDL publishes only the current value and no history at all, so a day that
// goes unrecorded is gone for good — which is why this table exists before
// anything draws from it. It starts empty and fills forwards.
//
// Keyed by mdlSlug rather than tmdbExternalId so one table serves both
// CachedMdlData and MdlSeasonLink: MDL files each season as its own entry with
// its own slug, and a season's rating is its own series.
//
// One row per slug per day, upserted — not one row per change. The live refresh
// debounces at 60s and mdlWatchers moves constantly, so "on change" would write
// dozens of rows an hour for anyone holding F5. The last reading of the day
// wins, which is ample for a number MDL publishes to one decimal — measured
// across 851 cached titles, not one carries a second. Days with no row mean
// nobody looked, not that nothing changed: a chart over this has to step,
// never interpolate.
//
// That single decimal is also why the rating alone is not the whole story. It
// is quantised to 0.1 steps, so a back-catalogue title resting on tens of
// thousands of votes never moves at all — but its rank shifts as others
// overtake it, and its audience keeps growing. Hence ranking and watchers
// sitting here beside the rating rather than being dropped as incidental.
model MdlRatingPoint {
  mdlSlug  String
  day      DateTime @db.Date
  rating   Float?
  ranking  Int?
  watchers Int?

  // (slug, day) IS the identity, so it is the primary key rather than a unique
  // index sitting next to a surrogate cuid. Measured on 5,000 synthetic rows,
  // the cuid and its index were ~35% of the table's weight on disk — and this
  // is a row nothing will ever reference by id.
  @@id([mdlSlug, day])
}

// Native titles scraped from MDL detail pages (the top lists don't carry them).
// Filled progressively in the background; "" = checked, no native title found.
model MdlNativeTitle {
  slug        String   @id
  nativeTitle String
  createdAt   DateTime @default(now())
}

model CachedKuryanaPerson {
  slug     String   @id
  dataJson Json
  cachedAt DateTime @default(now())
}

// Poster + title from an MDL detail page, keyed by MDL slug.
//
// The actor radar renders one of these per card and used to scrape them all on
// every render. MDL is scraped serially and fails in bursts, so a slow spell
// blanked the whole row at once. This table exists so a poster is never lost:
// a failed scrape falls back to the stored value instead of rendering nothing.
//
// Rows are still refreshed — an unreleased drama cycles through placeholder,
// teaser and final artwork, and renames itself along the way. cachedAt drives
// that, on an interval that depends on whether the show has aired.
model CachedMdlPoster {
  slug     String   @id
  poster   String?
  title    String?
  cachedAt DateTime @default(now())
}

// Home "universe" top lists (completed/ongoing/upcoming) per Kuryana country.
// The page always paints from here; a client-side live refresh re-scrapes
// Kuryana afterwards and updates this row for next time — see
// src/actions/mdl-top-refresh.ts.
model CachedMdlTop {
  id              String    @id @default(cuid())
  country         String // KuryanaTopCountry, e.g. "korean"
  excludeTags     String    @default("") // normalized tag_exclude param, "" if none
  dataJson        Json // { completed, ongoing, upcoming: KuryanaChineseShow[] }
  liveRefreshedAt DateTime?
  cachedAt        DateTime  @default(now())

  @@unique([country, excludeTags])
}

model MdlSeasonLink {
  id             String    @id @default(cuid())
  tmdbExternalId String
  season         Int
  mdlSlug        String
  mdlRating      Float?
  mdlRanking     Int?
  mdlPopularity  Int?
  mdlWatchers    Int?
  castJson       Json?
  tags           Json?
  genres         Json?
  // MDL's own broadcast range for THIS entry, e.g. "Aug 7, 2026 - Sep 19, 2026".
  // MDL files each season as its own entry, so it is the only per-season
  // source we have: TMDB's first/last_air_date are show-level.
  aired          String?
  synopsis       String?
  // Last light refresh of the volatile numbers (rating, rank, watchers).
  // Deliberately separate from cachedAt: bumping that one would keep pushing
  // the 7-day cast/synopsis cycle out of reach on pages viewed often.
  liveRefreshedAt DateTime?
  cachedAt       DateTime?

  @@unique([tmdbExternalId, season])
  @@index([tmdbExternalId])
}

model MdlAlias {
  id             String   @id @default(cuid())
  mdlSlug        String   @unique // the alias MDL slug (e.g. "the-glory-part-2")
  tmdbExternalId String // points to the main CachedMdlData entry
  createdAt      DateTime @default(now())

  @@index([tmdbExternalId])
}

model CachedMdlEpisode {
  id            String   @id @default(cuid())
  mdlSlug       String
  episodeNumber Int
  synopsis      String?
  episodeTitle  String?
  reviewCount   Int?
  cachedAt      DateTime @default(now())

  @@unique([mdlSlug, episodeNumber])
  @@index([mdlSlug])
}

model CachedEpisode {
  id            String   @id @default(cuid())
  mediaId       String
  airDate       String
  airDateTime   String? // exact ISO instant (from MDL), when the source knows it
  episodeNumber Int
  seasonNumber  Int
  episodeName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([mediaId, seasonNumber, episodeNumber])
  @@index([mediaId])
}
