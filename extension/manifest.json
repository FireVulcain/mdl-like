{
  "manifest_version": 3,
  "name": "Drama Calendar",
  "version": "1.5.0",
  "description": "Your personal drama airing calendar — shows from your watchlist.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dramatrackr.fr/*",
        "https://*.dramatrackr.fr/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "stills.js",
        "recaps.js",
        "recaps-cpophome.js",
        "recaps-reviewgeek.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cpophome.com/*",
        "https://cpophome.com/*",
        "https://www.thereviewgeek.com/*",
        "https://thereviewgeek.com/*"
      ],
      "js": [
        "tab-fetch.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drama Calendar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
